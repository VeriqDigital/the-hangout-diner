# Optional for the mockup; required to use Sanity Studio and published CMS content.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
# Optional; defaults to this tested API version.
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-02

# Set this to the actual preview/production origin before sharing a hosted link.
# Leave empty for localhost development. Do not use the existing B12 domain.
NEXT_PUBLIC_SITE_URL=

# Keep false for the sales concept. Only enable after production content review.
SITE_INDEXABLE=false
